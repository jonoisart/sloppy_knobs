{
  "name": "sloppy-knobs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build:pages": "VITE_BASE=/sloppy_knobs/ npm run build && VITE_BASE=/sloppy_knobs/ npm run check:dist",
    "e2e:built": "node scripts/e2e.mjs --built"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  },
  "description": "An audio coding language with knobs on \u2014 mangle voice notes and found sound in the browser."
}
